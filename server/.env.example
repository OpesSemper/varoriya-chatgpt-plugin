NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000

VARORIYA_API_BASE_URL=https://api.varoriya.com
VARORIYA_API_TIMEOUT_MS=15000
VARORIYA_API_KEY=varo_gk_replace_with_non_production_key

VARORIYA_AUTH_MODE=dev-api-key
VARORIYA_DEV_API_KEY=replace-with-at-least-32-random-characters
VARORIYA_DEV_PRINCIPAL_ID=local-developer
VARORIYA_DEV_SCOPES=generation:read,generation:create,billing:read,files:write

VARORIYA_OAUTH_ISSUER=https://auth.example.invalid
VARORIYA_OAUTH_AUDIENCES=https://plugin.example.invalid/mcp
VARORIYA_OAUTH_ALGORITHMS=RS256
VARORIYA_OAUTH_RESOURCE_OWNER_CLAIM=sub
VARORIYA_OAUTH_JWKS_URI=https://auth.example.invalid/.well-known/jwks.json

VARORIYA_MAX_REQUEST_COST_UNITS=100000
VARORIYA_MAX_USER_COST_UNITS_PER_WINDOW=500000
VARORIYA_COST_WINDOW_SECONDS=86400
VARORIYA_MAX_UPLOAD_BYTES=52428800
VARORIYA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm,audio/mpeg,audio/wav
VARORIYA_REMOTE_URLS_ENABLED=false
VARORIYA_REMOTE_URL_ALLOWED_HOSTS=
VARORIYA_REMOTE_URL_ALLOWED_PORTS=443
VARORIYA_REMOTE_URL_ALLOW_HTTP=false
VARORIYA_REMOTE_URL_ALLOW_PUBLIC_IP_LITERALS=false
VARORIYA_MODEL_POLICIES_JSON=[]
